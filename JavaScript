"use strict";

const TITAN_TMDB = {
  baseURL: "https://api.themoviedb.org/3",
  imageURL: "https://image.tmdb.org/t/p/w500",

  // Add your TMDB API Read Access Token here.
  accessToken: "YOUR_TMDB_READ_ACCESS_TOKEN",

  language: "en-US"
};

async function getTMDBDetails(id, type = "movie") {
  if (!["movie", "tv"].includes(type)) {
    throw new Error("Unsupported content type.");
  }

  if (!id || !/^\d+$/.test(String(id))) {
    throw new Error("Invalid TMDB ID.");
  }

  const url = new URL(
    `${TITAN_TMDB.baseURL}/${type}/${id}`
  );

  url.searchParams.set("language", TITAN_TMDB.language);

  const response = await fetch(url, {
    method: "GET",
    headers: {
      Accept: "application/json",
      Authorization: `Bearer ${TITAN_TMDB.accessToken}`
    }
  });

  if (!response.ok) {
    throw new Error(`TMDB request failed: ${response.status}`);
  }

  return response.json();
}

function getTMDBImage(path) {
  return path
    ? `${TITAN_TMDB.imageURL}${path}`
    : "";
}

function updatePosterCard(card, data, type) {
  const title = data.title || data.name || "Unknown title";
  const rating = Number(data.vote_average || 0).toFixed(1);
  const overview = data.overview || "No description available.";
  const releaseDate = data.release_date || data.first_air_date || "";
  const posterURL = getTMDBImage(data.poster_path);

  card.dataset.loaded = "true";
  card.dataset.tmdbTitle = title;
  card.dataset.tmdbRating = rating;

  // Update existing elements only.
  const image = card.querySelector("img");
  const titleElement = card.querySelector("[data-tmdb-title]");
  const ratingElement = card.querySelector("[data-tmdb-rating]");
  const overviewElement = card.querySelector("[data-tmdb-overview]");
  const dateElement = card.querySelector("[data-tmdb-date]");

  if (image && posterURL) {
    image.src = posterURL;
    image.alt = title;
    image.loading = "lazy";
  }

  if (titleElement) {
    titleElement.textContent = title;
  }

  if (ratingElement) {
    ratingElement.textContent = rating;
  }

  if (overviewElement) {
    overviewElement.textContent = overview;
  }

  if (dateElement) {
    dateElement.textContent = releaseDate;
  }

  card.setAttribute("aria-label", `${title}, rating ${rating}`);
}

async function loadTitanPosters() {
  const cards = document.querySelectorAll(
    ".poster-card[data-tmdb-id][data-tmdb-type]"
  );

  for (const card of cards) {
    if (card.dataset.loaded === "true") continue;

    const id = card.dataset.tmdbId;
    const type = card.dataset.tmdbType;

    try {
      card.dataset.loading = "true";

      const data = await getTMDBDetails(id, type);

      updatePosterCard(card, data, type);

      delete card.dataset.error;
    } catch (error) {
      console.error("TITAN poster error:", id, error);
      card.dataset.error = "true";
    } finally {
      delete card.dataset.loading;
    }
  }
}

document.addEventListener("DOMContentLoaded", loadTitanPosters);
"use strict";

const TITANMovieModal = (() => {
  let modal;
  let currentCard = null;

  function createModal() {
    if (modal) return modal;

    modal = document.createElement("div");
    modal.className = "movie-modal";
    modal.id = "titan-movie-modal";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    modal.setAttribute("aria-labelledby", "titan-modal-title");
    modal.hidden = true;

    modal.innerHTML = `
      <div class="movie-modal__backdrop" data-close-modal></div>

      <section class="movie-modal__panel">
        <button
          class="movie-modal__close"
          type="button"
          aria-label="Close movie details"
          data-close-modal
        >&#215;</button>

        <div class="movie-modal__content">
          <img
            class="movie-modal__poster"
            id="titan-modal-poster"
            alt=""
          >

          <div class="movie-modal__details">
            <p class="movie-modal__eyebrow">TITAN ORIGINAL DISCOVERY</p>

            <h2 id="titan-modal-title">Movie details</h2>

            <div class="movie-modal__meta">
              <span id="titan-modal-rating"></span>
              <span id="titan-modal-date"></span>
            </div>

            <p
              class="movie-modal__overview"
              id="titan-modal-overview"
            ></p>

            <p
              class="movie-modal__status"
              id="titan-modal-status"
              aria-live="polite"
            ></p>
          </div>
        </div>
      </section>
    `;

    document.body.appendChild(modal);

    modal.addEventListener("click", (event) => {
      if (event.target.closest("[data-close-modal]")) {
        close();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) {
        close();
      }
    });

    return modal;
  }

  function setText(id, value) {
    const element = document.getElementById(id);
    if (element) element.textContent = value || "";
  }

  function open(card) {
    if (!card) return;

    createModal();
    currentCard = card;

    const image = card.querySelector("img");
    const title =
      card.dataset.tmdbTitle ||
      card.querySelector("[data-tmdb-title]")?.textContent ||
      "Movie details";

    const rating =
      card.dataset.tmdbRating ||
      card.querySelector("[data-tmdb-rating]")?.textContent;

    const overview =
      card.querySelector("[data-tmdb-overview]")?.textContent;

    const date =
      card.querySelector("[data-tmdb-date]")?.textContent;

    const poster = document.getElementById("titan-modal-poster");

    poster.src = image?.currentSrc || image?.src || "";
    poster.alt = title;

    setText("titan-modal-title", title);
    setText("titan-modal-rating", rating ? `★ ${rating}/10` : "");
    setText("titan-modal-date", date || "");
    setText(
      "titan-modal-overview",
      overview || "Movie information is not available yet."
    );
    setText("titan-modal-status", "");

    modal.hidden = false;
    document.body.classList.add("titan-modal-open");

    modal.querySelector(".movie-modal__close")?.focus();
  }

  function close() {
    if (!modal || modal.hidden) return;

    modal.hidden = true;
    document.body.classList.remove("titan-modal-open");

    if (currentCard) {
      currentCard.focus?.();
    }

    currentCard = null;
  }

  function init() {
    createModal();

    document.addEventListener("click", (event) => {
      const card = event.target.closest(
        ".poster-card[data-tmdb-id][data-tmdb-type]"
      );

      if (!card) return;

      if (event.target.closest("a, button")) return;

      open(card);
    });

    document.querySelectorAll(".poster-card").forEach((card) => {
      if (!card.hasAttribute("tabindex")) {
        card.setAttribute("tabindex", "0");
      }

      card.addEventListener("keydown", (event) => {
        if (
          (event.key === "Enter" || event.key === " ") &&
          event.target === card
        ) {
          event.preventDefault();
          open(card);
        }
      });
    });
  }

  return { init, open, close };
})();

document.addEventListener("DOMContentLoaded", () => {
  TITANMovieModal.init();
});
